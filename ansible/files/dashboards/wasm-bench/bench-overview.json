      "description": "The durable path, for contrast with the relay panel beside it. This includes input delay, queueing and the write path, so it is the honest number for a consumer that reads the output topic rather than subscribing to the relay.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]

        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(redpanda_transform_e2e_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",

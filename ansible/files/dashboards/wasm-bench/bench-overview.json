      "type": "timeseries",
      "title": "transform e2e: input append -> output written and committed",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,

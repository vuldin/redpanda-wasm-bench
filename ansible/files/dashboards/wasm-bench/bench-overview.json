{
  "uid": "wasm-bench-overview",
  "title": "wasm bench: overview",
  "description": "The in-broker wasm transform benchmark at a glance. Latency first, then the gates that decide whether the latency means anything, then where the CPU went. Published numbers come from loadgen's own histograms, not from this Prometheus - see REPRODUCE.md.",
  "tags": [
    "wasm-bench"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "2s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "panels": [
    {
      "id": 9,
      "type": "stat",
      "title": "now running (autorun plan / phase / attempt)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(max by (plan, phase, attempt) (bench_phase_info), \"now\", \" / \", \"plan\", \"phase\", \"attempt\") or on() label_replace(vector(0), \"now\", \"no autorun phase in progress\", \"\", \"\")",
          "legendFormat": "{{now}}",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "description": "The autorun phase at the end of the selected time range, from bench_phase_info. Empty between phases, outside an autorun plan, and for runs older than the marker. The shaded regions on every graph are the same series over time: hover one for its plan, phase and attempt.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 20
        }
      }
    },
    {
      "id": 109,
      "type": "stat",
      "title": "loadgen (level / stage)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(max by (label, phase) (loadgen_phase_info), \"now\", \" / \", \"label\", \"phase\") or on() label_replace(vector(0), \"now\", \"loadgen idle\", \"\", \"\")",
          "legendFormat": "{{now}}",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "description": "The level loadgen is running (the runner's tag, e.g. bookdepth-10000) and its stage: preload, warmup, measure or drain. Only measure is in the published numbers; the green regions on the graphs are those windows. Idle between levels and while a phase deploys or settles.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 20
        }
      }
    },
    {
      "id": 1,
      "type": "row",
      "title": "Headline: in-broker fan-out latency",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []

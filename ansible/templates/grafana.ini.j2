# GENERATED by ansible/monitoring.yaml - do not edit on the host.

[paths]
data = /var/lib/grafana
logs = /var/log/grafana
plugins = /var/lib/grafana/plugins
provisioning = /etc/grafana/provisioning

[server]
http_port = {{ grafana_port }}
# The public address, so Grafana's own generated links and share URLs point at
# something reachable rather than at localhost.
root_url = http://{{ monitor_public_ip }}:{{ grafana_port }}/

[analytics]
reporting_enabled = false
check_for_updates = false

[security]
admin_user = admin
admin_password = {{ grafana_admin_password }}

# Anonymous viewer access, so the URL can be handed to someone and just open.
#
# This is only defensible because of where it sits: the security group admits
# one /32, this cluster holds generated order data and exists for a few hours.
# It is the wrong setting for anything that outlives a benchmark run. Editing
# still requires the admin login.
[auth.anonymous]
enabled = true
org_name = Main Org.
org_role = Viewer

[users]
default_theme = dark

[dashboards]
# The bench overview, so the URL lands on the thing you actually came to see
# instead of on an empty home page with a folder tree to navigate.
default_home_dashboard_path = /var/lib/grafana/dashboards/wasm-bench/bench-overview.json

[log]
mode = console file
level = info

[alerting]
enabled = false

[unified_alerting]
enabled = false

[Unit]
Description=Grafana
After=network-online.target
Wants=network-online.target

[Service]
User=grafana
Group=grafana
Type=simple
WorkingDirectory=/opt/grafana
ExecStart=/opt/grafana/bin/grafana server \
  --config=/etc/grafana/grafana.ini \
  --homepath=/opt/grafana
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

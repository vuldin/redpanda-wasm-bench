# GENERATED by ansible/monitoring.yaml from terraform/hosts.ini - do not edit
# on the host, it is overwritten on every `wb monitor deploy`.
#
# Two Redpanda endpoints, at deliberately different intervals:
#
#   /public_metrics  redpanda_*      every {{ prom_interval_public }}
#   /metrics         vectorized_*    every {{ prom_interval_internal }}
#
# Every metric this benchmark is about - redpanda_relay_*, redpanda_transform_*,
# redpanda_wasm_engine_*, redpanda_wasm_binary_* - is on the PUBLIC registry.
# That is worth knowing because it means the bench dashboards run entirely off
# the cheap endpoint, so it can be scraped tightly enough to see inside a 30s
# measurement window. The internal endpoint is scraped an order of magnitude
# more slowly: it carries the full per-shard Seastar set, which is where the
# series count and the scrape cost actually are, and nothing on the bench
# dashboards needs it. It is here for the symptoms-first dashboards.
#
# THE SCRAPE IS NOT THE MEASUREMENT. Every published number comes from loadgen's
# own before/after snapshots and its own latency histograms, not from this
# Prometheus. That separation is on purpose: it means the scrape interval can be
# chosen for legibility rather than defended as part of the methodology, and a
# run whose numbers must be beyond argument can set monitor_count = 0 and take
# the observer off the network entirely.

global:
  scrape_interval: {{ prom_interval_public }}
  evaluation_interval: 15s
  external_labels:
    redpanda_id: {{ redpanda_id }}

scrape_configs:
  # ---------------------------------------------------------------------------
  # Redpanda public metrics: redpanda_*. The bench dashboards are built on this.
  # ---------------------------------------------------------------------------
  - job_name: redpanda
    metrics_path: /public_metrics
    scrape_interval: {{ prom_interval_public }}
    static_configs:
{% for h in groups['broker'] %}
      - targets: ['{{ hostvars[h].private_ip }}:9644']
        labels: {redpanda_id: {{ redpanda_id }}, node_id: '{{ hostvars[h].id }}', host: 'broker{{ hostvars[h].id }}', role: broker}
{% endfor %}

  # ---------------------------------------------------------------------------
  # Redpanda internal metrics: vectorized_*. Loose interval on purpose - see
  # the header. This is the expensive endpoint, and the brokers it is scraped
  # from are the thing under measurement.
  # ---------------------------------------------------------------------------
  - job_name: redpanda-internal
    metrics_path: /metrics
    scrape_interval: {{ prom_interval_internal }}
    static_configs:
{% for h in groups['broker'] %}
      - targets: ['{{ hostvars[h].private_ip }}:9644']
        labels: {redpanda_id: {{ redpanda_id }}, node_id: '{{ hostvars[h].id }}', host: 'broker{{ hostvars[h].id }}', role: broker}
{% endfor %}

  # ---------------------------------------------------------------------------
  # Host metrics for every instance, the monitoring host included.
  #
  # `host` is the load-bearing label here. A panel legend showing "client3" is
  # readable; one showing 10.0.0.147:9100 has to be cross-referenced against
  # terraform output every time. client0 is loadgen and client1 is the external
  # matcher (see the topology tfvars), so knowing which is which is the
  # difference between "the client was starved" and "a client was busy".
  # ---------------------------------------------------------------------------
  - job_name: node
    scrape_interval: {{ prom_interval_node }}
    static_configs:
{% for h in groups['broker'] %}
      - targets: ['{{ hostvars[h].private_ip }}:{{ node_exporter_port }}']
        labels: {redpanda_id: {{ redpanda_id }}, node_id: '{{ hostvars[h].id }}', host: 'broker{{ hostvars[h].id }}', role: broker}
{% endfor %}
{% for h in groups['client'] %}
      - targets: ['{{ hostvars[h].private_ip }}:{{ node_exporter_port }}']
        labels: {redpanda_id: {{ redpanda_id }}, host: 'client{{ hostvars[h].id }}', role: client}
{% endfor %}
{% for h in groups['monitor'] | default([]) %}
      - targets: ['{{ hostvars[h].private_ip }}:{{ node_exporter_port }}']
        labels: {redpanda_id: {{ redpanda_id }}, host: 'monitor', role: monitor}
{% endfor %}

  # ---------------------------------------------------------------------------
  # loadgen's own live metrics, when it is run with -metrics-listen.
  #
  # Scraped at the tightest interval of anything here, and it is the only job
  # whose target is expected to be DOWN most of the time: loadgen is a
  # per-window batch process, not a service, so this job is up only while a
  # measurement is actually in flight. A red target here between runs is
  # correct. honor_labels keeps loadgen's own `phase` and `arm` labels.
  #
  # This is what answers "was the measurement itself sound" - send_lateness
  # against the pacing interval is the signal that caught a starved load
  # generator reporting an architecture result (METHODOLOGY 29).
  # ---------------------------------------------------------------------------
  - job_name: loadgen
    scrape_interval: {{ prom_interval_loadgen }}
    honor_labels: true
    static_configs:
{% for h in groups['client'] %}
      - targets: ['{{ hostvars[h].private_ip }}:{{ loadgen_metrics_port }}']
        labels: {redpanda_id: {{ redpanda_id }}, host: 'client{{ hostvars[h].id }}', role: client}
{% endfor %}

  - job_name: prometheus
    scrape_interval: 15s
    static_configs:
      - targets: ['localhost:{{ prometheus_port }}']
        labels: {redpanda_id: {{ redpanda_id }}, host: 'monitor', role: monitor}

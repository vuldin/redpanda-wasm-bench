# GENERATED by ansible/monitoring.yaml - do not edit on the host.
apiVersion: 1

providers:
  - name: wasm-bench
    orgId: 1
    type: file
    options:
      path: /var/lib/grafana/dashboards
      # Each subdirectory becomes a Grafana folder, so wasm-bench/ lands in a
      # folder called wasm-bench and anything sync-dashboards.sh adds gets its
      # own.
      foldersFromFilesStructure: true
    # Rescan often: it means a dashboard fix can be pushed mid-run with
    # `wb monitor dashboards` and show up without a Grafana restart, which
    # matters when the cluster is billing and the run is in flight.
    updateIntervalSeconds: 10
    disableDeletion: false
    allowUiUpdates: false

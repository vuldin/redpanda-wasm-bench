# GENERATED by ansible/monitoring.yaml - do not edit on the host.
apiVersion: 1

datasources:
  - name: Prometheus
    # Fixed uid, and every dashboard in this repo refers to it by this exact
    # string. Grafana dashboards exported from elsewhere carry whatever uid
    # they were built against, which is why a dashboard dropped in by hand
    # renders empty panels until it is retargeted - scripts/sync-dashboards.sh
    # does that rewrite on the way in.
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://localhost:{{ prometheus_port }}
    isDefault: true
    editable: false
    jsonData:
      httpMethod: POST
      # Matches the public-endpoint scrape interval, so $__rate_interval comes
      # out at something sane rather than at Grafana's 15s assumption. Get this
      # wrong and every rate() panel on a 30s window reads as flat.
      timeInterval: {{ prom_interval_public }}
      manageAlerts: false

# What waiting for the output quorum costs in-broker consumers: the broker's
# RELAY_DELIVERY option, set on the producing transform.
#
#   precommit  (default) the relay pushes each output record from the
#              transform callback, before its output write is even queued:
#              the lowest latency, but a consumer can act on a record that
#              never becomes durable if the leader fails
#   committed  the relay pushes only after the output batch's write has
#              returned, i.e. a quorum of the output partition's replicas
#              has acknowledged it - what a Kafka consumer could fetch
#
# Same matcher, book and order flow as production-shape.plan; the modes are
# interleaved so cluster drift cannot pose as a mode difference. Needs a broker
# built with RELAY_DELIVERY (bench/local-relay-delivery.sh, run by the offline
# gate, fails without it).
#
#   scripts/autorun.sh check plans/relay-modes.plan
#   scripts/autorun.sh start plans/relay-modes.plan
#   RUN_DIR=<run> scripts/autorun.sh start --existing plans/relay-modes.plan   (on a live cluster)
#
# 6 brokers + 3 clients + monitoring, ~$55/hr; ~30 min of phases.

TEST="Relay delivery: precommit vs committed"
TEST_ABOUT="What waiting for the output quorum (RELAY_DELIVERY=committed) costs in-broker consumers, against delivering before the write (precommit)."
TOPOLOGY=six-broker
# Region preference for autorun's region selection (first with capacity wins).
# us-west-2 first: every six-broker series so far ran in us-west-2a, and the
# region is part of a result's fingerprint. The environment wins.
: "${REGIONS:=us-west-2 us-east-1 us-east-2 eu-west-1}"; export REGIONS
DEPLOY_ARGS=(-e transform_memory_limit=16777216 -e transform_instances_per_core=40 -e transform_snapshot_max_size=16777216)

E2=(ORDERS_PER_RECORD=15 RATE=30000 PAYLOAD=650 ACKS=all RF=3
    WARMUP=10s DRAIN=30s RELAY_STAGE_METRICS=true WRITE_CACHING=true
    LINGER_MS=0 SAMPLE_EVERY=10 PRODUCERS=1 GUEST=book-matcher STATE=off CANCEL_FRACTION=0.3
    MODE=bookdepth BOOKDEPTH_LEVELS=1000 DURATION=60s)

for t in 1 2; do
  about "trial $t of 2: fan-out 1, precommit" \
    "Depth 1,000, 60s, delivered before the output write. Watch the headline latency."
  phase "fo1-precommit-t$t" 5 run e2 "${E2[@]}" FANOUT=1 RELAY_DELIVERY=precommit
  about "trial $t of 2: fan-out 1, committed" \
    "The same, delivered once the output quorum acknowledged. Compare its headline latency with the precommit phase before it."
  phase "fo1-committed-t$t" 5 run e2 "${E2[@]}" FANOUT=1 RELAY_DELIVERY=committed
done
about "fan-out 20, precommit" \
  "20 subscribers per order. Watch the headline latency and relay throughput."
phase fo20-precommit 5 run e2 "${E2[@]}" FANOUT=20 RELAY_DELIVERY=precommit
about "fan-out 20, committed" \
  "The same, commit-gated. Compare with the phase before it."
phase fo20-committed 5 run e2 "${E2[@]}" FANOUT=20 RELAY_DELIVERY=committed

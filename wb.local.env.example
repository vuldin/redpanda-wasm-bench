# Copy to wb.local.env (gitignored) and edit. Read by scripts/wb,
# scripts/autorun.sh (through wb) and scripts/offline-gate.sh.
# Anything already set in your environment wins.

# AWS: a profile you can `aws sso login` with. Instances are tagged
# owner=rp-percore-benchmark; teardown verification sweeps by that tag.
: "${AWS_PROFILE:=my-sso-profile}"

# An EC2 keypair: the public half is imported by terraform, the private half
# is how every script reaches the instances (user ubuntu).
: "${BENCH_PUB_KEY:=$HOME/.ssh/my-bench-key.pub}"
: "${BENCH_SSH_KEY:=$HOME/.ssh/my-bench-key.pem}"

# Your checkouts. The broker is the transform-latency-instrumentation branch of
# github.com/vuldin/redpanda, built with bazel (see README).
: "${REDPANDA_SRC:=$HOME/src/redpanda}"
: "${WASM_CLIENTS_SRC:=$HOME/src/redpanda-wasm-clients}"
export AWS_PROFILE BENCH_PUB_KEY BENCH_SSH_KEY REDPANDA_SRC WASM_CLIENTS_SRC

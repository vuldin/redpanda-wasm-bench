# Copy to wb.local.env (gitignored) and edit. Read through scripts/lib-env.sh
# by wb, autorun.sh, offline-gate.sh and the local broker tests. Anything
# already set in your environment wins.

# --- required: your EC2 keypair ----------------------------------------------
# The public half is imported by terraform, the private half is how every
# script reaches the instances (user ubuntu). There is no default.
: "${BENCH_PUB_KEY:=$HOME/.ssh/my-bench-key.pub}"
: "${BENCH_SSH_KEY:=$HOME/.ssh/my-bench-key.pem}"

# --- AWS credentials -----------------------------------------------------------
# A profile you can `aws sso login` with. Leave unset to use the AWS CLI's
# normal credential chain (env vars, default profile). Instances are tagged
# owner=rp-percore-benchmark; teardown verification sweeps by that tag.
# : "${AWS_PROFILE:=my-sso-profile}"

# --- optional: your checkouts ----------------------------------------------------
# Default: cloned side by side with this repo -
#   <dir>/redpanda-wasm-bench  <dir>/redpanda  <dir>/redpanda-wasm-clients
# Set these only if yours live elsewhere. The broker is the
# transform-latency-instrumentation branch of github.com/vuldin/redpanda,
# built with bazel (docs/SETUP.md).
# : "${REDPANDA_SRC:=$HOME/src/redpanda}"
# : "${WASM_CLIENTS_SRC:=$HOME/src/redpanda-wasm-clients}"

# --- optional: keep a copy of every finished run ---------------------------------
# autorun copies each run directory here plus a sha256-checked tarball, e.g. a
# directory outside the repo that you back up. Unset: runs stay in results/.
# : "${ARCHIVE_DIR:=$HOME/bench-archive}"
